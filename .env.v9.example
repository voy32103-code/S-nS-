# Canonical V9 local template. Never commit populated production values.
ASPNETCORE_URLS=http://localhost:5080
VITE_API_URL=http://localhost:5080
SANSO_POSTGRES=Host=localhost;Port=5432;Username=sanso;Password=change-me;Database=sanso
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Required for durable onboarding when PostgreSQL is configured.
# Generate 32 random bytes and Base64-encode them; inject the real value from a secret manager.
SANSO_FIELD_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_EXACTLY_32_RANDOM_BYTES
SANSO_FIELD_ENCRYPTION_KEY_VERSION=local-v1

# Production identity/provider variables intentionally omitted until architecture and providers are approved.

