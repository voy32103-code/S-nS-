{
  "openapi": "3.1.0",
  "info": {
    "title": "SànSổ API V4",
    "version": "0.4.1-pilot",
    "description": "Pilot contract. No endpoint submits tax filings or tax payments. Tax results may be NEEDS_REVIEW."
  },
  "servers": [{ "url": "http://localhost:5080" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": { "get": { "security": [], "responses": { "200": { "description": "Healthy or explicit development degraded state" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } } },
    "/api/auth/login": { "post": { "security": [], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } }, "responses": { "200": { "description": "Tenant-bound opaque session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/auth/logout": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "204": { "description": "Session revoked" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/auth/me": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Current tenant principal" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/imports/preview": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Preview only; no business projection written", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportPreview" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/imports/confirm": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportConfirmRequest" } } } }, "responses": { "200": { "description": "Explicit confirmation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportConfirmation" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/api/dashboard": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Tenant dashboard" } } } },
    "/api/orders": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Tenant orders" } } } },
    "/api/reconciliations/current": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Line-level reconciliation and explanations" } } } },
    "/api/raw-events": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Idempotent raw event acceptance" } } }, "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Raw event scope" } } } },
    "/api/tax/periods/{period}/calculate": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }, { "$ref": "#/components/parameters/PeriodPath" }], "responses": { "200": { "description": "Deterministic result or NEEDS_REVIEW; never LLM-selected tax rate" } } } },
    "/api/refunds": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Reversal/adjustment preserving original history" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/periods/{period}/lock": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }, { "$ref": "#/components/parameters/PeriodPath" }], "responses": { "200": { "description": "Development lock result" }, "204": { "description": "Persisted lock" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/inventory/{sku}/reserve": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }, { "name": "sku", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Idempotent reservation" }, "409": { "description": "Insufficient ATP" } } } },
    "/api/team/invitations": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Tenant/role/expiry-bound invitation" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/support/grants": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Step-up protected bounded support grant" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/billing/trial": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Trial state" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/copilot/explain": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Evidence-bound explanation or REFUSED" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/onboarding": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Ordered onboarding snapshot; persisted flag explicit" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/onboarding/disclaimer": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Explicit versioned disclaimer confirmation" }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/api/notifications": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Tenant inbox with masked recipient" } } }, "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Development envelope with persisted=false" }, "503": { "description": "Production persistence required" } } } },
    "/api/notifications/{id}/acknowledge": { "post": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }, { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "In-app acknowledgement" }, "404": { "description": "Not found in tenant scope" } } } },
    "/api/exports/reconciliation.csv": { "get": { "parameters": [{ "$ref": "#/components/parameters/TenantHeader" }], "responses": { "200": { "description": "Traceable formula-safe CSV", "content": { "text/csv": { "schema": { "type": "string" } } } } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" } },
    "parameters": {
      "TenantHeader": { "name": "X-Tenant-Id", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "PeriodPath": { "name": "period", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "responses": {
      "BadRequest": { "description": "Safe validation response" },
      "Unauthorized": { "description": "Missing, invalid, expired or tenant-mismatched session" },
      "Forbidden": { "description": "Authenticated role lacks permission" },
      "ServiceUnavailable": { "description": "Required dependency unavailable" }
    },
    "schemas": {
      "LoginRequest": { "type": "object", "required": ["email", "password", "tenantId"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password", "writeOnly": true }, "tenantId": { "type": "string" }, "totpCode": { "type": ["string", "null"], "pattern": "^[0-9]{6}$" } } },
      "LoginResponse": { "type": "object", "required": ["token", "principal"], "properties": { "token": { "type": "string", "writeOnly": true }, "principal": { "type": "object" } } },
      "ImportConfirmRequest": { "type": "object", "required": ["previewToken", "checksum"], "properties": { "previewToken": { "type": "string", "writeOnly": true }, "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
      "ImportRow": { "type": "object", "required": ["rowNumber", "raw", "errors"], "properties": { "rowNumber": { "type": "integer" }, "orderCode": { "type": ["string", "null"] }, "amount": { "type": ["integer", "null"] }, "occurredAt": { "type": ["string", "null"], "format": "date-time" }, "raw": { "type": "object", "additionalProperties": { "type": "string" } }, "errors": { "type": "array", "items": { "type": "string" } } } },
      "ImportPreview": { "type": "object", "required": ["previewToken", "expiresAt", "format", "templateVersion", "checksum", "rows", "errors", "duplicate", "persisted"], "properties": { "batchId": { "type": ["string", "null"] }, "previewToken": { "type": "string", "writeOnly": true }, "expiresAt": { "type": "string", "format": "date-time" }, "format": { "enum": ["CSV", "XLSX"] }, "templateVersion": { "type": "string" }, "checksum": { "type": "string" }, "rows": { "type": "array", "items": { "$ref": "#/components/schemas/ImportRow" } }, "errors": { "type": "array", "items": { "type": "string" } }, "duplicate": { "type": "boolean" }, "persisted": { "type": "boolean" } } },
      "ImportConfirmation": { "type": "object", "required": ["checksum", "acceptedRows", "rejectedRows", "duplicate", "persisted"], "properties": { "batchId": { "type": ["string", "null"] }, "checksum": { "type": "string" }, "acceptedRows": { "type": "integer" }, "rejectedRows": { "type": "integer" }, "duplicate": { "type": "boolean" }, "persisted": { "type": "boolean" } } }
    }
  }
}
